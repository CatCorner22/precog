# Copy to .env only for a self-hosted or local Postgres setup. The live preview
# needs none of these: auth uses the baked preview client and the database
# falls back to an in-memory PGLite. On Vercel, set them in the project's
# environment variables. A production build refuses to complete without
# DATABASE_URL and BETTER_AUTH_SECRET (see scripts/migrate.mjs).

# Postgres connection string (Neon pooled host recommended). Required in production.
DATABASE_URL=

# Better Auth session signing secret, 32+ random bytes. Required in production.
BETTER_AUTH_SECRET=

# Public URL of this deployment, e.g. https://app.example.com
BETTER_AUTH_URL=

# Upstream sign-in broker credentials for this app (Google and X federate through it).
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=

# xAI API key for the coach and builder assistants. Spends the app owner's quota.
XAI_API_KEY=

# Set to "false" to turn sign-in off entirely (local single-user mode).
VITE_AUTH_ENABLED=

# Injected by the platform on publish; leave unset locally.
VITE_PUBLIC_HOSTNAME=
VITE_SHOW_BUILT_WITH_GROK=
VITE_ALLOW_FORKING=
VITE_PROJECT_ID=
