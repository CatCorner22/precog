# Every environment variable the app reads, grouped by feature. Copy to .env
# only for a self-hosted or local Postgres setup. The live preview needs none
# of these: auth uses the baked preview client and the database falls back to
# an in-memory PGLite. On Vercel, set them in the project's environment
# variables. A production build refuses to complete without DATABASE_URL and
# BETTER_AUTH_SECRET, and warns about each feature below that is half set up
# (see scripts/migrate.mjs). scripts/deploy-config.test.mjs fails when the
# server reads a variable this file does not name.

# --- Database and sign-in (required in production) ---------------------------

# Postgres connection string (Neon pooled host recommended).
DATABASE_URL=

# Better Auth session signing secret, 32+ random bytes.
BETTER_AUTH_SECRET=

# Public URL of this deployment, e.g. https://app.example.com. Sign-in, Stripe
# return pages, the QuickBooks callback and digest email links all use it.
BETTER_AUTH_URL=

# Optional: a different public URL for links that leave the app (Stripe return
# pages, the QuickBooks callback, digest emails). Defaults to BETTER_AUTH_URL.
PUBLIC_APP_URL=

# Optional, self-hosted only: set to 1 when your own proxy overwrites
# x-forwarded-host and x-forwarded-proto, so the app may build links from them
# when neither URL above is set. Vercel's proxy is trusted without it.
TRUST_FORWARDED_HOST=

# Upstream sign-in broker credentials for this app (Google and X federate through it).
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=

# Set to "false" to turn sign-in off entirely (local single-user mode).
VITE_AUTH_ENABLED=

# --- Coach and builder assistants ---------------------------------------------

# xAI API key. Spends the app owner's quota. Empty: the assistants are off.
XAI_API_KEY=

# Daily ceilings on model calls, per signed-in user and for the whole app
# (defaults 150 and 1500). Counted in Postgres so every instance shares them.
LLM_DAILY_PER_USER=
LLM_DAILY_GLOBAL=
# Per calling address (default 450, above one user's, since an office shares
# an address), and the pool all accounts with neither a verified email nor a
# Google or X sign-in share (default 300).
LLM_DAILY_PER_ADDRESS=
LLM_DAILY_UNVERIFIED=

# --- Scheduled job (reminders, purges, QuickBooks refresh) --------------------

# Vercel calls /api/cron/digest every Monday (vercel.json) with this secret as
# a bearer token. Empty: every run is refused, so no reminder email is sent,
# deleted businesses are never purged after their 30-day grace period, and
# QuickBooks connections are never re-read. Any long random string.
CRON_SECRET=

# --- Reminder email (Resend) ---------------------------------------------------

# Resend API key and the From address. Both are needed to send; empty: the
# scheduled job reports what it would have sent and emails nobody.
RESEND_API_KEY=
EMAIL_FROM=
# Optional Reply-To address for reminder email.
EMAIL_REPLY_TO=

# --- Billing (Stripe) ----------------------------------------------------------

# Secret key and the two price ids (fixed assessment, monthly firm plan). All
# three are needed; empty: the firm workspace shows "billing not connected"
# and keeps the manual stage buttons.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ASSESSMENT=
STRIPE_PRICE_MONTHLY=
# Signing secret of the Stripe webhook endpoint. Empty: payment events are
# refused, so a paid checkout never updates the firm's plan.
STRIPE_WEBHOOK_SECRET=

# --- QuickBooks Online link (read-only) ---------------------------------------

# Intuit app credentials. Both, and INTEGRATION_KEY below, are needed; empty:
# the firm workspace says the QuickBooks link is not available on this deployment.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# "sandbox" reads Intuit's sandbox company data; anything else, production.
QBO_ENVIRONMENT=
# Master key that encrypts stored QuickBooks tokens and signs connect
# requests, 32+ random bytes. To rotate it, move the old value to
# INTEGRATION_KEY_PREVIOUS and set a new INTEGRATION_KEY: tokens sealed under
# either still open, and each refresh reseals under the new key. Changing it
# without keeping the old value makes every linked company connect again.
INTEGRATION_KEY=
INTEGRATION_KEY_PREVIOUS=

# --- Error reporting ------------------------------------------------------------

# Where server and browser errors go: a Sentry DSN, or else any URL that
# accepts one JSON POST per error. Both empty: errors go to the server log only.
SENTRY_DSN=
ERROR_REPORT_URL=
# Release tag attached to browser error reports (the server uses the commit
# Vercel injects as VERCEL_GIT_COMMIT_SHA).
VITE_RELEASE=

# --- Hosting outside Vercel -----------------------------------------------------

# The one header your own proxy sets to the client address (and strips from
# incoming requests), e.g. x-real-ip. Empty: on Vercel its own headers are
# trusted; elsewhere the socket address is used for rate limits.
TRUSTED_CLIENT_IP_HEADER=

# --- Deploy-time migrations ------------------------------------------------------

# How long `npm run db:migrate` waits for another migration run's lock, in
# milliseconds (default 30000, at most 300000).
MIGRATION_LOCK_TIMEOUT_MS=

# --- Set by the platform on publish; leave unset locally ------------------------

VITE_PUBLIC_HOSTNAME=
VITE_SHOW_BUILT_WITH_GROK=
VITE_ALLOW_FORKING=
VITE_PROJECT_ID=
# Set to false to disable writing monthly review results into the control evidence log.
VITE_EVIDENCE_BRIDGE=

# Optional, isolated browser tests only. Leave blank for Playwright's managed Chromium.
# Select an installed executable; this setting does not bypass browser policy.
PLAYWRIGHT_CHROMIUM_EXECUTABLE=
